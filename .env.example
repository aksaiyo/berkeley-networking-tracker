# Public browser-safe Neon endpoints (never put a database URL here)
NEXT_PUBLIC_NEON_AUTH_URL=https://your-auth-endpoint.neon.tech
NEXT_PUBLIC_NEON_DATA_API_URL=https://your-data-api-endpoint.neon.tech/rest/v1

# Server-only; needed only if you apply migrations with a database client
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional only for server-side Neon Auth integrations; this SPA does not require them
NEON_AUTH_BASE_URL=https://your-auth-endpoint.neon.tech
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
